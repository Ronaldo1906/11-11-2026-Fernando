@startuml casos_de_uso
left to right direction
actor Cliente
rectangle ALQUILAPC {
  usecase "Registrar Datos\nBásicos del Servicio" as UC1
  usecase "Calcular\nDías Adicionales" as UC2
  usecase "Aplicar Descuento\nDías Adicionales" as UC3
  usecase "Calcular\nAlquiler Base" as UC4
  usecase "Seleccionar\nTipo de Servicio" as UC5
  usecase "Calcular Cargo\nFuera de la Ciudad" as UC6
  usecase "Aplicar Descuento\nServicio en Establecimiento" as UC7
  usecase "Generar Factura" as UC8
}
Cliente --> UC1
Cliente --> UC5
UC1 ..> UC2 : <<include>>
UC1 ..> UC4 : <<include>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC8 : <<include>>
UC3 ..> UC8 : <<include>>
UC4 ..> UC8 : <<include>>
UC6 ..> UC5 : <<extend>>
UC7 ..> UC5 : <<extend>>
UC6 ..> UC8 : <<include>>
UC7 ..> UC8 : <<include>>
@enduml
